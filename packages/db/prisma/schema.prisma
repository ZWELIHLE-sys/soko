generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ================================
// LOCATION HIERARCHY
// Province → District → City → Seller/Buyer/Product
// Same structure scales SA → Africa → World
// ================================

enum LocationType {
  CONTINENT
  COUNTRY
  PROVINCE
  DISTRICT
  CITY
}

model Location {
  id       String       @id @default(cuid())
  name     String
  type     LocationType
  code     String?      // e.g. "KZN", "GP", "ZA"
  parentId String?

  // Self relation — this is the tree structure
  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children Location[] @relation("LocationTree")

  // Everything in Soko is tagged to a location
  sellers  Seller[]
  users    User[]
  products Product[]
  riders   Rider[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ================================
// USERS — Buyers and Admins
// ================================

enum UserRole {
  BUYER
  ADMIN
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  phone      String?
  password   String
  role       UserRole @default(BUYER)
  avatar     String?
  isVerified         Boolean   @default(false)
  emailVerifyToken   String?   // 6-digit OTP (plain, short-lived)
  emailVerifyExpiry  DateTime?

  // Location — which city this buyer is in
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  // Relations
  orders     Order[]
  reviews    Review[]
  wishlist   Wishlist[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ================================
// SELLERS — African Creators
// ================================

enum SellerStatus {
  PENDING     // Applied, waiting for review
  VERIFIED    // PA Verified badge granted
  SUSPENDED   // Violated rules
  REJECTED    // Did not meet requirements
}

model Seller {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String
  brandName   String       // Their shop name e.g. "Nomvula's Beadwork"
  phone       String
  password    String
  bio             String?      // Their story
  suburb          String?      // Specific area / neighbourhood within their city
  customCategory  String?      // Used when seller selects "Other" category
  avatar          String?
  banner          String?      // Shop banner image
  status          SellerStatus @default(PENDING)
  isVerified      Boolean      @default(false)

  // Location — which city this seller operates from
  locationId  String
  location    Location     @relation(fields: [locationId], references: [id])

  // What category they mainly sell
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id])

  // Verification proof
  proofUrls          String[]  @default([])   // 3 required photos
  materialsPhotoUrl  String?                  // materials/tools photo
  videoUrl           String?                  // 30-60 sec craft video
  socialMediaLink    String?                  // optional Instagram/TikTok/Facebook
  hasDeclaration     Boolean   @default(false) // legal self-declaration checkbox

  // Relations
  products       Product[]
  orders         Order[]
  reviews        Review[]
  marketListings MarketListing[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ================================
// CATEGORIES
// ================================

model Category {
  id          String    @id @default(cuid())
  name        String    @unique  // e.g. "Fashion", "Art", "Furniture"
  slug        String    @unique  // e.g. "fashion", "art", "furniture"
  icon        String?            // emoji or icon name
  description String?
  isActive    Boolean   @default(true)

  // Relations
  sellers     Seller[]
  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ================================
// PRODUCTS — What Sellers List
// ================================

enum ProductStatus {
  DRAFT      // Seller still writing details
  ACTIVE     // Live on the marketplace
  SOLD_OUT   // No stock left
  SUSPENDED  // Admin removed it
}

model Product {
  id          String        @id @default(cuid())
  name        String
  description String
  price       Float
  stock       Int           @default(1)
  status      ProductStatus @default(DRAFT)
  images      String[]      // Array of image URLs from Cloudinary

  // Who made it
  sellerId    String
  seller      Seller        @relation(fields: [sellerId], references: [id])

  // What category
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])

  // Where it was made — city of origin
  locationId  String
  location    Location      @relation(fields: [locationId], references: [id])

  // Relations
  orderItems  OrderItem[]
  reviews     Review[]
  wishlist    Wishlist[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ================================
// ORDERS
// ================================

enum OrderStatus {
  PENDING      // Just placed
  CONFIRMED    // Seller confirmed
  PACKED       // Ready for pickup
  IN_TRANSIT   // With rider or courier
  DELIVERED    // Received by buyer
  CANCELLED    // Cancelled
  REFUNDED     // Money returned
}

enum DeliveryTier {
  SELLER_ARRANGED // Current: buyer and seller coordinate delivery directly

  // TODO: DHL API integration — contact DHL Express South Africa for SME/eCommerce
  // partnership programme. Vuna holds a platform-level DHL account, negotiates bulk
  // rates, and sellers book pickups from the seller dashboard. Vuna generates the
  // waybill via DHL API and buyer receives a tracking number automatically.
  // See: apps/web/src/app/checkout/page.tsx and apps/web/src/app/api/orders/create/route.ts
  DHL             // DHL Express — platform-level account (future)

  SOKO_RIDER      // Vuna Rider local fleet (future)
  COURIER_GUY     // The Courier Guy (future)
  FASTWAY         // Fastway Couriers (future)
  PARGO           // Pargo pickup point (future)
  ARAMEX          // Aramex Africa (future)
}

model Order {
  id             String       @id @default(cuid())
  orderNumber    String       @unique @default(cuid())
  status         OrderStatus  @default(PENDING)
  totalAmount    Float
  deliveryFee    Float
  deliveryTier   DeliveryTier
  trackingNumber String?

  // Who bought
  buyerId        String
  buyer          User         @relation(fields: [buyerId], references: [id])

  // Who sold
  sellerId       String
  seller         Seller       @relation(fields: [sellerId], references: [id])

  // Delivery address
  deliveryAddress String
  deliveryCityId  String

  // Rider if Soko Rider was used
  riderId        String?
  rider          Rider?       @relation(fields: [riderId], references: [id])

  // Items in this order
  items          OrderItem[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  price     Float   // Price at time of purchase

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])
}

// ================================
// SOKO RIDERS — Local Delivery
// ================================

enum RiderStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Rider {
  id         String     @id @default(cuid())
  name       String
  phone      String     @unique
  email      String     @unique
  password   String
  vehicle    String     // "motorbike", "van", "bakkie"
  status     RiderStatus @default(ACTIVE)
  isVerified Boolean    @default(false)

  // Which city they operate in
  locationId String
  location   Location   @relation(fields: [locationId], references: [id])

  orders     Order[]

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// ================================
// REVIEWS
// ================================

model Review {
  id        String  @id @default(cuid())
  rating    Int     // 1 to 5
  comment   String?

  userId    String
  user      User    @relation(fields: [userId], references: [id])

  sellerId  String
  seller    Seller  @relation(fields: [sellerId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}

// ================================
// VUNA MARKET — Monthly Pop-Up Market
// Admin creates the event and sets dates manually.
// Sellers apply; admin approves. Countdown shown on landing page.
// ================================

model Market {
  id                  String   @id @default(cuid())
  title               String   // e.g. "Vuna Winter Market"
  description         String?
  theme               String?  // e.g. "Winter Warmers"
  startDate           DateTime
  endDate             DateTime
  applicationDeadline DateTime
  bannerImage         String?
  isActive            Boolean  @default(true)
  maxListings         Int?

  listings  MarketListing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MarketListingStatus {
  PENDING
  APPROVED
  REJECTED
}

model MarketListing {
  id         String              @id @default(cuid())
  status     MarketListingStatus @default(PENDING)
  sellerNote String?
  adminNote  String?
  approvedAt DateTime?
  productIds String[]            @default([])

  marketId  String
  market    Market @relation(fields: [marketId], references: [id])

  sellerId  String
  seller    Seller @relation(fields: [sellerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([marketId, sellerId])
}

// ================================
// WISHLIST
// ================================

model Wishlist {
  id        String  @id @default(cuid())

  userId    String
  user      User    @relation(fields: [userId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, productId]) // Can't wishlist same product twice
}


