{
  "name": "vuna-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@vuna/web",
    "dev:admin": "turbo run dev --filter=@vuna/admin",
    "dev:mobile": "turbo run dev --filter=@vuna/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate --filter=@vuna/db",
    "db:push": "turbo run db:push --filter=@vuna/db",
    "db:migrate": "turbo run db:migrate --filter=@vuna/db",
    "db:studio": "turbo run db:studio --filter=@vuna/db",
    "db:seed": "turbo run db:seed --filter=@vuna/db"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
