{
  "name": "@vuna/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:push":     "prisma db push --config prisma.config.ts",
    "db:migrate":  "prisma migrate dev --config prisma.config.ts",
    "db:studio":   "prisma studio --config prisma.config.ts",
    "db:seed":     "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "prisma": "^7.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
