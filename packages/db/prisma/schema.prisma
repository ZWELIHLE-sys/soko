generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ================================
// LOCATION HIERARCHY
// Province → District → City → Seller/Buyer/Product
// Same structure scales SA → Africa → World
// ================================

enum LocationType {
  CONTINENT
  COUNTRY
  PROVINCE
  DISTRICT
  CITY
}

model Location {
  id         String       @id @default(cuid())
  name       String
  type       LocationType
  code       String?      // e.g. "KZN", "GP", "ZA"
  parentId   String?
  // Self relation — this is the tree structure
  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children Location[] @relation("LocationTree")

  // Everything in Soko is tagged to a location
  sellers  Seller[]
  users    User[]
  products Product[]
  riders   Rider[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ================================
// USERS — Buyers and Admins
// ================================

enum UserRole {
  BUYER
  ADMIN
}

enum UserStatus {
  ACTIVE     // Normal — can shop and bid
  SUSPENDED  // Admin blocked — cannot transact
  FLAGGED    // Under review — admin notified
}

model User {
  id         String     @id @default(cuid())
  email      String     @unique
  name       String
  phone      String?
  password   String
  role       UserRole   @default(BUYER)
  avatar     String?
  status             UserStatus @default(ACTIVE)
  isVerified         Boolean    @default(false)  // email OTP confirmed
  isAdminVerified    Boolean    @default(false)  // admin manually verified
  emailVerifyToken     String?
  emailVerifyExpiry    DateTime?
  resetPasswordToken   String?
  resetPasswordExpiry  DateTime?
  suburb               String?    // area within their city

  // Location — which city this buyer is in
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  // Relations
  orders        Order[]
  reviews       Review[]
  wishlist      Wishlist[]
  bids          Bid[]          @relation("UserBids")
  wonAuctions   Auction[]      @relation("AuctionWinner")
  testimonials  Testimonial[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ================================
// SELLERS — African Creators
// ================================

enum SellerStatus {
  PENDING     // Applied, waiting for review
  VERIFIED    // PA Verified badge granted
  SUSPENDED   // Violated rules
  REJECTED    // Did not meet requirements
}

model Seller {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String
  brandName   String       // Their shop name e.g. "Nomvula's Beadwork"
  phone       String
  password    String
  bio             String?      // Their story
  suburb          String?      // Specific area / neighbourhood within their city
  customCategory  String?      // Used when seller selects "Other" category
  avatar          String?
  banner          String?      // Shop banner image
  status          SellerStatus @default(PENDING)
  isVerified      Boolean      @default(false)

  // Location — which city this seller operates from
  locationId  String
  location    Location     @relation(fields: [locationId], references: [id])

  // What category they mainly sell
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id])

  // Verification proof
  proofUrls          String[]  @default([])   // 3 required photos
  materialsPhotoUrl  String?                  // materials/tools photo
  videoUrl           String?                  // 30-60 sec craft video
  socialMediaLink    String?                  // optional Instagram/TikTok/Facebook
  hasDeclaration       Boolean   @default(false) // legal self-declaration checkbox
  resetPasswordToken   String?
  resetPasswordExpiry  DateTime?

  // Payment / banking details (for direct EFT payouts)
  bankName      String?
  accountHolder String?
  accountNumber String?
  accountType   String?  // "Cheque", "Savings", "Current"
  branchCode    String?

  // Relations
  products       Product[]
  orders         Order[]
  reviews        Review[]
  marketListings MarketListing[]
  auctions       Auction[]
  pieces         Piece[]
  commissionInvoices CommissionInvoice[]
  featuredMakerSpots FeaturedMaker[]
  makerInResidenceMarkets Market[] @relation("MarketMakerInResidence")

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ================================
// LIVE ENERGY — Admin as live MC
// Announcements fire instantly onto the live banner across the platform.
// FeaturedMaker is the weekly spotlight (the PR trade: seller donates a
// welcome piece, gets a week of amplification on the homepage).
// ================================

model Announcement {
  id        String    @id @default(cuid())
  message   String
  link      String?   // optional CTA link e.g. /market or /product/xyz
  kind      String    @default("GENERAL") // GENERAL | SPOTLIGHT | LAST_CHANCE | HAMMER | WELCOME
  channel   String    @default("GLOBAL")  // GLOBAL | MARKET | AUCTION | SHOP — which room hears it (agri gets its own later)
  isActive  Boolean   @default(true)      // shown in the live banner while active
  expiresAt DateTime? // optional auto-expiry
  createdAt DateTime  @default(now())

  // Optional: tie an MC moment to a piece so its journey page can replay "this happened"
  pieceId   String?
  piece     Piece?    @relation(fields: [pieceId], references: [id])

  @@index([isActive, createdAt])
  @@index([channel, isActive])
}

model FeaturedMaker {
  id             String   @id @default(cuid())
  sellerId       String
  seller         Seller   @relation(fields: [sellerId], references: [id])
  note           String?  // admin's one-liner: why this maker, this week
  welcomeProductId String? // the donated welcome piece (optional)
  isActive       Boolean  @default(true) // only one active at a time (enforced in service)
  weekStart      DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([isActive])
}

// ================================
// CATEGORIES
// ================================

model Category {
  id          String    @id @default(cuid())
  name        String    @unique  // e.g. "Fashion", "Art", "Furniture"
  slug        String    @unique  // e.g. "fashion", "art", "furniture"
  icon        String?            // emoji or icon name
  description String?
  isActive    Boolean   @default(true)

  // Relations
  sellers     Seller[]
  products    Product[]
  auctions    Auction[]
  pieces      Piece[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ================================
// PRODUCTS — What Sellers List
// ================================

enum ProductStatus {
  DRAFT      // Seller still writing details
  ACTIVE     // Live on the marketplace
  SOLD_OUT   // No stock left
  SUSPENDED  // Admin removed it
}

model Product {
  id          String        @id @default(cuid())
  name        String
  description String
  price       Float
  stock       Int           @default(1)
  status      ProductStatus @default(DRAFT)
  images      String[]      @default([])  // Array of image URLs from Cloudinary

  // Bulk pricing — optional; when set, buyers ordering >= bulkMinQty pay bulkPrice per unit
  bulkMinQty  Int?
  bulkPrice   Float?

  // Who made it
  sellerId    String
  seller      Seller        @relation(fields: [sellerId], references: [id])

  // What category
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])

  // Where it was made — city of origin
  locationId  String
  location    Location      @relation(fields: [locationId], references: [id])

  // Track B link — when this shop product came from a Piece's journey (post-auction)
  pieceId     String?
  piece       Piece?        @relation(fields: [pieceId], references: [id])

  // Relations
  orderItems       OrderItem[]
  reviews          Review[]
  wishlist         Wishlist[]
  featuredListing  FeaturedListing?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ================================
// FEATURED LISTINGS (Home Page Spotlight)
// ================================

// Phase 1: admin manually pins products with an expiry date
// Phase 2: isPaidTier flag will be used for paid promoted slots (future)
model FeaturedListing {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id])
  expiresAt   DateTime
  note        String?  // admin note — why this product is featured
  isPaidTier  Boolean  @default(false) // Phase 2: true = seller paid for placement
  createdAt   DateTime @default(now())
}

// ================================
// ORDERS
// ================================

enum OrderStatus {
  PENDING      // Just placed
  CONFIRMED    // Seller confirmed
  PACKED       // Ready for pickup
  IN_TRANSIT   // With rider or courier
  DELIVERED    // Received by buyer
  CANCELLED    // Cancelled
  REFUNDED     // Money returned
}

enum DeliveryTier {
  SELLER_ARRANGED // Current: buyer and seller coordinate delivery directly

  // TODO: DHL API integration — contact DHL Express South Africa for SME/eCommerce
  // partnership programme. Vuna holds a platform-level DHL account, negotiates bulk
  // rates, and sellers book pickups from the seller dashboard. Vuna generates the
  // waybill via DHL API and buyer receives a tracking number automatically.
  // See: apps/web/src/app/checkout/page.tsx and apps/web/src/app/api/orders/create/route.ts
  DHL             // DHL Express — platform-level account (future)

  SOKO_RIDER      // Vuna Rider local fleet (future)
  COURIER_GUY     // The Courier Guy (future)
  FASTWAY         // Fastway Couriers (future)
  PARGO           // Pargo pickup point (future)
  ARAMEX          // Aramex Africa (future)
}

model Order {
  id             String       @id @default(cuid())
  orderNumber    String       @unique @default(cuid())
  status         OrderStatus  @default(PENDING)
  totalAmount    Float
  deliveryFee    Float
  deliveryTier   DeliveryTier
  trackingNumber String?

  // Manual EFT payment tracking (Mzansi pivot)
  paymentRef        String?    // Optional reference buyer used in their EFT
  paymentProofUrl   String?    // Cloudinary URL of proof of payment uploaded by buyer
  paymentSubmittedAt DateTime? // When buyer uploaded proof
  paymentVerifiedAt DateTime?  // When seller confirmed receipt of payment
  commission        Float?     // Amount Vuna invoices the seller monthly (10% of totalAmount)
  commissionStatus  String     @default("PENDING")  // PENDING → INVOICED → PAID
  commissionInvoiceId String?
  commissionInvoice   CommissionInvoice? @relation(fields: [commissionInvoiceId], references: [id])

  // Live energy — set when this order was among the first 3 placed during a live market day
  firstThreeMarketId String?

  // Who bought
  buyerId        String
  buyer          User         @relation(fields: [buyerId], references: [id])

  // Who sold
  sellerId       String
  seller         Seller       @relation(fields: [sellerId], references: [id])

  // Delivery address
  deliveryAddress String
  deliveryCityId  String

  // Rider if Soko Rider was used
  riderId        String?
  rider          Rider?       @relation(fields: [riderId], references: [id])

  // Items in this order
  items          OrderItem[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ================================
// COMMISSION INVOICES — Monthly Vuna commission billed to sellers
// Each delivered order has a commission amount (10% of totalAmount).
// Admin generates a CommissionInvoice per seller per period that bundles
// the seller's pending commissions. Seller pays Vuna via EFT.
// ================================

model CommissionInvoice {
  id           String   @id @default(cuid())
  sellerId     String
  seller       Seller   @relation(fields: [sellerId], references: [id])
  periodStart  DateTime
  periodEnd    DateTime
  amount       Float
  status       String   @default("OUTSTANDING")  // OUTSTANDING | PAID | CANCELLED
  generatedAt  DateTime @default(now())
  paidAt       DateTime?
  paidProofUrl String?  // Seller can upload EFT proof when they pay Vuna
  adminNote    String?

  orders       Order[]

  @@index([sellerId, status])
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  price     Float   // Price at time of purchase

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])
}

// ================================
// SOKO RIDERS — Local Delivery
// ================================

enum RiderStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Rider {
  id         String     @id @default(cuid())
  name       String
  phone      String     @unique
  email      String     @unique
  password   String
  vehicle    String     // "motorbike", "van", "bakkie"
  status     RiderStatus @default(ACTIVE)
  isVerified Boolean    @default(false)

  // Which city they operate in
  locationId String
  location   Location   @relation(fields: [locationId], references: [id])

  orders     Order[]

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// ================================
// REVIEWS
// ================================

model Review {
  id        String  @id @default(cuid())
  rating    Int     // 1 to 5
  comment   String?

  userId    String
  user      User    @relation(fields: [userId], references: [id])

  sellerId  String
  seller    Seller  @relation(fields: [sellerId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}

// ================================
// VUNA PIECES — Track B Special Piece Journey
// A Piece is a special item that moves through: MARKET → AUCTION → SHOP (if unsold) → SOLD.
// Regular shop listings (Track A) have no Piece — Product is sold directly.
// Seller can RETIRE a Piece at any stage (pull from journey).
// MarketListing, Auction and Product each carry a nullable pieceId.
// ================================

enum PieceStage {
  MARKET      // Currently in a market event
  AUCTION     // Currently in an auction event
  FEATURED    // Victory lap: homepage featured spotlight (time-boxed), buyable, auto-lands in SHOP on expiry
  SHOP        // Available in shop (post-auction, unsold or buy-it-now)
  SOLD        // Sold — to auction winner or shop buyer
  RETIRED     // Seller pulled the piece from the journey
}

model Piece {
  id           String      @id @default(cuid())
  title        String      // Stays consistent across stages
  description  String
  images       String[]    @default([])
  currentStage PieceStage  @default(MARKET)

  sellerId     String
  seller       Seller      @relation(fields: [sellerId], references: [id])

  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])

  // Reverse relations — each stage entry that belongs to this piece
  marketListings  MarketListing[]
  auctions        Auction[]
  products        Product[]
  announcements   Announcement[]  // MC moments about this piece across its journey

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([sellerId, currentStage])
}

// ================================
// VUNA MARKET — Weekly/Monthly Pop-Up Markets
// Sunday Vuna Market (weekly), Friday Night Market (monthly).
// Admin creates events, approves stall applications, assigns stall numbers and Maker in Residence.
// ================================

enum MarketType {
  SUNDAY_MARKET       // Weekly — every Sunday 8AM–6PM
  FRIDAY_NIGHT_MARKET // Monthly — last Friday of every month 5PM–11PM
}

model Market {
  id                  String     @id @default(cuid())
  marketType          MarketType @default(SUNDAY_MARKET)
  title               String
  description         String?
  theme               String?
  startDate           DateTime
  endDate             DateTime
  applicationDeadline DateTime
  bannerImage         String?
  isActive            Boolean    @default(true)
  maxListings         Int?       // stall limit — scarcity is intentional

  // Featured seller for this market event
  makerInResidenceId  String?
  makerInResident     Seller?    @relation("MarketMakerInResidence", fields: [makerInResidenceId], references: [id])

  listings  MarketListing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MarketListingStatus {
  PENDING
  APPROVED
  REJECTED
}

model MarketListing {
  id           String              @id @default(cuid())
  status       MarketListingStatus @default(PENDING)
  sellerNote   String?
  adminNote    String?
  approvedAt   DateTime?
  stallNumber  Int?                // assigned by admin when approved
  productIds   String[]            @default([])
  stallMessage String?             // seller's "come see what I brought today" message
  marketPrice  Float?              // seller's market-only price (shown during market hours only)

  marketId  String
  market    Market @relation(fields: [marketId], references: [id])

  sellerId  String
  seller    Seller @relation(fields: [sellerId], references: [id])

  // Track B link — when this listing is showcasing a special Piece on its journey
  pieceId   String?
  piece     Piece?  @relation(fields: [pieceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([marketId, sellerId])
}

// ================================
// VUNA AUCTIONS — Curated Auction Events
// Admin creates an AuctionEvent (like an auction house catalogue).
// Sellers submit individual items (Auction) to that event.
// Admin approves items into the catalogue.
// On biddingStartDate the event goes LIVE — all approved items bid simultaneously.
// Hammer prices are published publicly after the event ends.
// ================================

enum AuctionEventStatus {
  ANNOUNCED      // Visible to sellers — submissions open
  CATALOGUE_OPEN // Submissions closed — catalogue visible to buyers, bidding not yet open
  LIVE           // Bidding is open
  ENDED          // Auction concluded — results published
}

model AuctionEvent {
  id                 String             @id @default(cuid())
  title              String             // e.g. "Vuna Heritage Auction — July 2026"
  description        String?
  theme              String?            // e.g. "Contemporary African Craft"
  bannerImage        String?
  status             AuctionEventStatus @default(ANNOUNCED)
  submissionDeadline DateTime           // Sellers must submit by this date
  catalogueOpenDate  DateTime           // Catalogue published to buyers (preview period)
  biddingStartDate   DateTime           // Bidding opens
  biddingEndDate     DateTime           // Hammer falls
  isActive           Boolean            @default(true)

  items              Auction[]

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

enum AuctionStatus {
  PENDING    // Submitted — awaiting admin review for the catalogue
  APPROVED   // In the catalogue — visible during preview, bidding when event goes LIVE
  LIVE       // Actively receiving bids
  ENDED      // Bidding closed — winner determined
  CANCELLED  // Rejected or withdrawn
}

model Auction {
  id              String        @id @default(cuid())
  title           String
  description     String
  artistStatement String?       // 2-3 sentences from the maker about this piece
  images          String[]      @default([])
  startPrice      Float
  reservePrice    Float?        // Hidden minimum — if not met, no sale
  currentBid      Float?        // Updated on each valid bid
  status          AuctionStatus @default(PENDING)
  adminNote       String?

  // Linked to an auction event (admin creates the event, seller submits items to it)
  auctionEventId  String?
  auctionEvent    AuctionEvent? @relation(fields: [auctionEventId], references: [id])

  // Who is selling
  sellerId        String
  seller          Seller        @relation(fields: [sellerId], references: [id])

  // Category for display
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])

  // Winner after auction ends
  winnerId        String?
  winner          User?         @relation("AuctionWinner", fields: [winnerId], references: [id])

  // Track B link — when this auction item is on a Piece's journey
  pieceId         String?
  piece           Piece?        @relation(fields: [pieceId], references: [id])

  bids            Bid[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Bid {
  id        String   @id @default(cuid())
  amount    Float

  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id])

  bidderId  String
  bidder    User     @relation("UserBids", fields: [bidderId], references: [id])

  createdAt DateTime @default(now())
}

// ================================
// WISHLIST
// ================================

model Wishlist {
  id        String  @id @default(cuid())

  userId    String
  user      User    @relation(fields: [userId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, productId]) // Can't wishlist same product twice
}

// ================================
// TESTIMONIALS — Buyer platform feedback shown on home page
// Admin approves before going live. Auto-approved initially, admin can unpublish.
// ================================
model Testimonial {
  id         String   @id @default(cuid())
  content    String
  rating     Int      @default(5)  // 1-5 stars
  isApproved Boolean  @default(true)

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  createdAt  DateTime @default(now())
}
